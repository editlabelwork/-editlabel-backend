  "bugs": {
    "url": "https://github.com/editlabelwork/-editlabel-backend/issues"
  },
  "homepage": "https://github.com/editlabelwork/-editlabel-backend#readme",
  "description": "",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "speakeasy": "^2.0.0",
    "uuid": "^9.0.1",
    "zod": "^4.4.1",
    "winston": "^3.14.2",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/speakeasy": "^2.0.12",
    "@types/uuid": "^9.0.8",
    "eslint": "^10.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^6.3.4",
