{
  "name": "editlabel-backend-repo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:security": "jest --testPathPattern=security",
    "test:integration": "jest --testPathPattern=integration",
    "build": "tsc",
    "start": "node dist/src/app.js",
    "dev": "ts-node src/app.ts",
    "dev:watch": "nodemon --exec ts-node src/app.ts",
    "migrate": "prisma migrate dev",
    "db:create": "createdb editlabel",
    "db:drop": "dropdb editlabel",
    "db:seed": "ts-node src/database/seed.ts",
    "check:compliance": "ts-node src/compliance/check.ts",
    "logs": "tail -f logs/app.log"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/editlabelwork/-editlabel-backend.git"
  },
  "keywords": [],
